{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  }
}
