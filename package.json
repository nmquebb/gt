{
  "name": "checkout-continuity",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun run dev:api\" \"bun run dev:web\" \"bun run dev:mobile\"",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mobile": "bun run --cwd apps/mobile ios",
    "ios": "bun run --cwd apps/mobile ios",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "bun run typecheck:api && bun run typecheck:sdk && bun run typecheck:web && bun run typecheck:mobile",
    "typecheck:api": "bun run --cwd apps/api typecheck",
    "typecheck:sdk": "bun run --cwd packages/sdk typecheck",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:mobile": "bun run --cwd apps/mobile typecheck",
    "test": "bun test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
